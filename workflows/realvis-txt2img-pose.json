{
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Load Checkpoint" },
    "inputs": {
      "ckpt_name": "realvisxlV50.safetensors"
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "Empty Latent Image" },
    "inputs": {
      "width": 832,
      "height": 1216,
      "batch_size": 1
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "CLIP Text Encode (Positive)" },
    "inputs": {
      "text": "PLACEHOLDER_POSITIVE_PROMPT",
      "clip": ["4", 1]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "CLIP Text Encode (Negative)" },
    "inputs": {
      "text": "PLACEHOLDER_NEGATIVE_PROMPT",
      "clip": ["4", 1]
    }
  },
  "10": {
    "class_type": "LoadImage",
    "_meta": { "title": "Load Pose Image" },
    "inputs": {
      "image": "PLACEHOLDER_POSE.png",
      "upload": "image"
    }
  },
  "11": {
    "class_type": "DWPreprocessor",
    "_meta": { "title": "DWPose Estimator" },
    "inputs": {
      "image": ["10", 0],
      "detect_hand": "enable",
      "detect_body": "enable",
      "detect_face": "enable",
      "resolution": 1024,
      "bbox_detector": "yolox_l.onnx",
      "pose_estimator": "dw-ll_ucoco_384.onnx"
    }
  },
  "12": {
    "class_type": "ControlNetLoader",
    "_meta": { "title": "Load ControlNet (OpenPose SDXL)" },
    "inputs": {
      "control_net_name": "openpose-sdxl/diffusion_pytorch_model.safetensors"
    }
  },
  "13": {
    "class_type": "ControlNetApplyAdvanced",
    "_meta": { "title": "Apply ControlNet (OpenPose)" },
    "inputs": {
      "positive": ["6", 0],
      "negative": ["7", 0],
      "control_net": ["12", 0],
      "image": ["11", 0],
      "strength": 0.8,
      "start_percent": 0.0,
      "end_percent": 1.0
    }
  },
  "3": {
    "class_type": "KSampler",
    "_meta": { "title": "KSampler" },
    "inputs": {
      "seed": 0,
      "steps": 30,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["13", 0],
      "negative": ["13", 1],
      "latent_image": ["5", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": {
      "samples": ["3", 0],
      "vae": ["4", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" },
    "inputs": {
      "filename_prefix": "synthetic_portrait_pose",
      "images": ["8", 0]
    }
  }
}
