# Copy to .env and fill in. .env is gitignored — never commit real values.
# Declare shape only: no absolute path from any machine belongs in this file.

# --- RunPod (metered GPU; Phases 5-6). infra/up.sh reads these. ---
RUNPOD_API_KEY=""
# ID of a pre-created network volume that holds the models (persists across pods).
RUNPOD_NETWORK_VOLUME_ID=""
# Datacenter the volume lives in (the pod must land there), e.g. EU-RO-1.
RUNPOD_DATACENTER=""
# GPU type id (RunPod's exact string). Default in up.sh: "NVIDIA RTX PRO 4500 Blackwell".
RUNPOD_GPU_TYPE=""
# SSH key path (public half is injected into the pod). Default: ~/.ssh/id_ed25519_runpod
# RUNPOD_SSH_KEY="$HOME/.ssh/id_ed25519_runpod"

# Publish ComfyUI's port on RunPod's HTTP proxy. Default off (tunnel-only).
#
# Set to 1 ONLY as an escape hatch for the case that motivated it: RunPod sometimes
# returns a pod that reaches RUNNING with no public IP and no port mapping, which the
# SSH tunnel cannot reach at all. The proxy needs no public IP, so it works exactly then.
#
# It is a PUBLIC, UNAUTHENTICATED URL — RunPod's docs state "the Pod ID provides only
# obscurity, not security" — and ComfyUI has no auth. It is also NOT a supported render
# path: treat it as a diagnostic channel and tear the pod down promptly.
# RUNPOD_EXPOSE_HTTP=1

# Readiness deadlines in seconds before up.sh tears the pod down itself.
# Defaults: 180 tunnelled, 420 when RUNPOD_EXPOSE_HTTP=1.
# READY_DEADLINE_TUNNEL_SECS=180
# READY_DEADLINE_PROXY_SECS=420
